# F1 Engineering Application Environment Configuration
# =====================================================
# Copy this file to .env and adjust values as needed

# Data Source: true = FastF1 (real data), false = Mock fixtures
LIVE_DATA=true

# Default season for data queries  
DEFAULT_SEASON=2025

# Optional: Override cache directories
# PARQUET_DIR=/app/data/cache/parquet
# FASTF1_CACHE=/app/data/cache/sqlite
